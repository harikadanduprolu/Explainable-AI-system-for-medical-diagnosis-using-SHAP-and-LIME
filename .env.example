# Environment Variables for Explainable Medical AI System
# Copy this file to .env and update with your values
# NEVER commit .env to version control!

# ============================================================================
# Application Settings
# ============================================================================
APP_ENV=production
APP_NAME="Explainable Medical AI System"
APP_VERSION=1.0.0
DEBUG=false

# ============================================================================
# Server Configuration
# ============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# ============================================================================
# Security
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY_HERE

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# API Key for external integrations (optional)
API_KEY=

# ============================================================================
# Database (Optional - for future use)
# ============================================================================
# PostgreSQL (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/medical_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# MongoDB Atlas (for user authentication)
MONGODB_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DATABASE_NAME=medical_ai_db

# ============================================================================
# Authentication & JWT
# ============================================================================
# JWT Token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================================
# Model Configuration
# ============================================================================
MODEL_PATH=./trained_models
MODEL_CACHE_SIZE=100
ENABLE_MODEL_CACHING=true

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/application.log
AUDIT_LOG_PATH=audit_logs/production_events.jsonl

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ============================================================================
# Monitoring
# ============================================================================
SENTRY_DSN=
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================================================
# External Services (Optional)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ============================================================================
# HIPAA/Security Settings
# ============================================================================
ENABLE_AUDIT_LOGGING=true
ENCRYPT_PATIENT_DATA=true
SESSION_TIMEOUT=1800
MAX_LOGIN_ATTEMPTS=5

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_WHATIF_ANALYSIS=true
ENABLE_SHAP_EXPLANATIONS=true
ENABLE_LIME_EXPLANATIONS=true
ENABLE_API_DOCS=true
